# The credential the Reporting API authenticates against the cloud with when it
# reconciles it. Copy this file to clouds.yaml, set its mode to 600 and fill in
# every <...> value. The prod overlay generates the Secret
# tally-reconciliation-auth from it.
#
# The entry name is what os_cloud in reconciliation/clouds-config.yaml names.
# docs/how-to/openstack/reconcile-a-cloud.md says which account the sync needs,
# how to check it, and how to create the application credential below so that
# it only reads.
clouds:
  <os-cloud>:
    auth_type: v3applicationcredential
    auth:
      auth_url: <auth-url>
      application_credential_id: <application-credential-id>
      application_credential_secret: <application-credential-secret>
    region_name: <region-name>
    interface: public
