# The password of tally_console, the login role the console reads the engine
# database as. Copy this file to tally-console-db.env and generate the value
# with `openssl rand -hex 32`. It has to be printable ASCII without spaces.
#
# Job tally-migrate sets the role's password to this value on every deploy, so
# changing it and running `make prod-up` rotates the password. TimescaleDB does
# not mount this Secret, so a rotation does not restart the database.
password=
