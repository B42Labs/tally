# The credentials of TimescaleDB and the Reporting API's connection to it.
# Copy this file to tally-db.env and fill in every value.
#
# Generate both passwords with `openssl rand -hex 32`. A hex value needs no
# encoding, neither in db-url below nor in the URL `make prod-migrate` builds.
#
# TimescaleDB reads both passwords only on the first start of an empty volume.
# engine-password stays required although this cluster runs no engine: the
# initdb script that creates the engine's reader role fails on an empty one.
password=
engine-password=
# What the Reporting API connects with. Put the value of password in place of
# <password>.
db-url=postgres://tally:<password>@timescaledb:5432/tally_reporting?sslmode=disable
