# The credentials of TimescaleDB and the connections the Reporting API, the
# migration Job and the scheduler open to it. Copy this file to tally-db.env
# and fill in every value.
#
# Generate both passwords with `openssl rand -hex 32`. A hex value needs no
# encoding, neither in the three URLs below nor in the URL the how-to builds
# for the ingest credential and the pricing catalog.
#
# TimescaleDB reads both passwords only on the first start of an empty volume.
# engine-password is what the initdb script creates the engine's reader role
# with, and it fails on an empty one.
password=
engine-password=
# What the Reporting API and the migration Job's reporting container connect
# with. Put the value of password in place of <password>.
db-url=postgres://tally:<password>@timescaledb:5432/tally_reporting?sslmode=disable
# What the scheduler and the migration Job's engine container connect to the
# engine's own database with. Put the value of password in place of
# <password>.
engine-db-url=postgres://tally:<password>@timescaledb:5432/tally_engine?sslmode=disable
# What the scheduler reads the Reporting API's database through, as the role
# that only selects. Put the value of engine-password in place of
# <engine-password>.
engine-reporting-db-url=postgres://tally_engine:<engine-password>@timescaledb:5432/tally_reporting?sslmode=disable
