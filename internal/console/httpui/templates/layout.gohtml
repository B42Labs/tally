{{define "layout"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>tally console: {{.Title}}</title>
<link rel="stylesheet" href="/static/console.css">
</head>
<body>
<nav>
<a href="/">Overview</a>
<a href="/projects">Projects</a>
<a href="/resources">Resources</a>
<a href="/pricing">Pricing</a>
</nav>
<main>
<h1>{{.Title}}</h1>
{{template "content" .Data}}
</main>
<footer>
<h2>Where this page came from</h2>
<ul>
{{range .Sources}}<li><span>{{.Kind}}</span> {{.Text}}</li>
{{else}}<li>this page read nothing</li>
{{end}}</ul>
</footer>
</body>
</html>
{{end}}
