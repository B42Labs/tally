{
  "uid": "tally-fixture",
  "title": "Tally / Fixture",
  "templating": {
    "list": [
      {
        "name": "cloud",
        "type": "query",
        "multi": true,
        "query": "label_values(tally_current_resources, cloud)"
      },
      {
        "name": "api_base",
        "type": "textbox",
        "query": "https://api.tally.127-0-0-1.nip.io:8443"
      },
      {
        "name": "interval",
        "type": "interval"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Ingest",
      "panels": [
        {
          "type": "timeseries",
          "title": "Event ingest rate",
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (cloud) (rate(tally_events_ingested_total{cloud=~\"$cloud\"}[5m]))"
            },
            {
              "refId": "B",
              "expr": "sum by (cloud) (rate(tally_events_rejected_total{cloud=~\"$cloud\"}[5m]))"
            }
          ]
        }
      ]
    },
    {
      "type": "stat",
      "title": "Clouds reporting",
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (cloud) (tally_current_resources))"
        }
      ]
    },
    {
      "type": "text",
      "title": "How to read this"
    }
  ]
}
