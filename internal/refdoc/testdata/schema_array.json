{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Fixture adjustments",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "rate"],
        "properties": {
            "kind": {"enum": ["discount", "surcharge"]},
            "rate": {"type": "string", "pattern": "^0(\\.\\d{1,6})?$"},
            "note": {"type": "string", "maxLength": 200}
        }
    }
}
