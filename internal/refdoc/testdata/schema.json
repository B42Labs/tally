{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Fixture catalog",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "entries"],
    "properties": {
        "version": {"type": "string", "minLength": 1},
        "kind": {"enum": ["draft", "final"]},
        "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "entries": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"$ref": "#/$defs/entry"}
            }
        }
    },
    "$defs": {
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["measures"],
            "properties": {
                "measures": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"$ref": "#/$defs/measure"}
                },
                "window": {"$ref": "#/$defs/window"},
                "note": {"type": "string", "maxLength": 500}
            }
        },
        "measure": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/rate"},
            "required": ["metric", "kind"],
            "properties": {
                "metric": {"type": "string", "minLength": 1},
                "kind": {"enum": ["gauge", "counter"]},
                "hourly": {"$ref": "#/$defs/rate"},
                "each": {"$ref": "#/$defs/rate"},
                "either": {"oneOf": [{"type": "string"}, {"type": "number"}]}
            },
            "oneOf": [
                {
                    "properties": {"kind": {"const": "gauge"}},
                    "required": ["hourly"],
                    "not": {"required": ["each"]}
                },
                {
                    "properties": {"kind": {"const": "counter"}},
                    "required": ["each"],
                    "not": {"required": ["hourly"]}
                }
            ]
        },
        "labels": {
            "type": "object",
            "required": ["name"],
            "properties": {"name": {"type": "string"}},
            "additionalProperties": {"type": "string"}
        },
        "window": {
            "type": "object",
            "required": ["from"],
            "properties": {
                "from": {"type": "string"},
                "to": {"type": "string"}
            }
        },
        "rate": {
            "oneOf": [
                {"type": "number", "minimum": 0},
                {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
            ]
        }
    }
}
