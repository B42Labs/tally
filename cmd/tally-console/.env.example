# Demo console configuration.
#
# Every variable is read from the environment with the TALLY_ prefix
# (roadmap/00-conventions.md section 8). Secrets also accept the *_FILE
# convention, which is how a Kubernetes Secret volume reaches the process
# without the value appearing in a pod spec:
# TALLY_CONSOLE_API_TOKEN_FILE=/run/secrets/tally/console-token
# Setting a secret and its *_FILE companion at the same time is an error.
#
# The console reads and writes nothing. It renders what the Reporting API and
# the engine database hold, and it is run on a developer's machine rather than
# deployed.

# Log level: DEBUG, INFO, WARN, ERROR.
TALLY_LOG_LEVEL=INFO

# IP address the console binds. The default keeps the console on the machine it
# runs on. A deployment behind a Gateway sets 0.0.0.0. The process speaks plain
# HTTP.
TALLY_CONSOLE_HTTP_ADDR=127.0.0.1

# Port the console listens on. The default avoids 8090 and 8091, which the
# simulator compose stack takes.
TALLY_CONSOLE_HTTP_PORT=8095

# Port the probes and the metrics are served on, at the address the console
# binds. It has to differ from TALLY_CONSOLE_HTTP_PORT, so that a route
# publishing the pages cannot reach them.
TALLY_CONSOLE_OPS_PORT=8096

# Whether GET /metrics on that port serves the instruments. false makes it
# answer 404.
TALLY_METRICS_ENABLED=true

# Base URL of the Reporting API, without the /api/v1 suffix. Required; there is
# no default. It has to be https unless its host is loopback or
# TALLY_CONSOLE_REPORTING_INSECURE allows a plaintext one, because the token
# below rides on every call. The dev cluster's is
# https://api.tally.127-0-0-1.nip.io:8443
TALLY_CONSOLE_REPORTING_URL=

# Allows an http Reporting API on a host that is not loopback. It exists for a
# console and an API in the same namespace. Anywhere else it puts the token
# below on the wire in cleartext.
TALLY_CONSOLE_REPORTING_INSECURE=false

# Bearer token the console reads the Reporting API with. It has to carry
# read_all, which every route the console reads accepts and which cannot change
# the registry: `tally-reporting-admin create-api-token --role read_all` issues
# one. Required; there is no default. Supports TALLY_CONSOLE_API_TOKEN_FILE.
TALLY_CONSOLE_API_TOKEN=

# PEM file holding the CA that signed the Reporting API's certificate. Empty
# trusts the system store, which is what a public certificate needs. The dev
# cluster signs its own, and `make -s ca > tally-ca.crt` writes that CA out.
TALLY_CONSOLE_CA_FILE=

# PostgreSQL connection string of the engine database, opened for reads only:
# billing periods, runs, statements, pricing versions and correction deltas
# have no read API, so the console queries them directly. Required; there is no
# default. Supports TALLY_CONSOLE_ENGINE_DB_URL_FILE.
#
# Connect as tally_console, which may only select: `tally-engine
# ensure-console-role` creates it after engine migration 3. On the dev cluster
# `make migrate` does, and the URL is:
# TALLY_CONSOLE_ENGINE_DB_URL=postgres://tally_console:tally-dev-password@db.tally.127-0-0-1.nip.io:5432/tally_engine?sslmode=disable
TALLY_CONSOLE_ENGINE_DB_URL=

# The one operator allowed to sign in, as one user:bcrypt-hash line in htpasswd
# format. Required; there is no default. `htpasswd -nBC 12 <user>` makes the
# line, and the console refuses every hash that is not bcrypt and a bcrypt cost
# below 10. The line is read at startup, so rotating it means a restart.
# Supports TALLY_CONSOLE_HTPASSWD_FILE.
TALLY_CONSOLE_HTPASSWD=
