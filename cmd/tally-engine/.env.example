# Metering engine configuration.
#
# The engine CLI reads every variable from the environment with the TALLY_
# prefix (roadmap/00-conventions.md section 8). The two database secrets also
# accept the *_FILE convention, which is how a Kubernetes Secret reaches the
# process without the value appearing in a pod spec:
# TALLY_ENGINE_DB_URL_FILE=/run/secrets/tally/engine-db-url
# TALLY_ENGINE_REPORTING_DB_URL_FILE=/run/secrets/tally/reporting-db-url
# Setting a secret and its *_FILE companion at the same time is an error.

# Log level: DEBUG, INFO, WARN, ERROR.
TALLY_LOG_LEVEL=INFO

# PostgreSQL connection string of the engine's own database, which holds the
# runs and their records. Required by the subcommands that reach a database;
# there is no default. Supports TALLY_ENGINE_DB_URL_FILE.
#
# On the dev cluster the database is reached through the Gateway's postgres
# listener:
# TALLY_ENGINE_DB_URL=postgres://tally:tally-dev-password@db.tally.127-0-0-1.nip.io:5432/tally_engine?sslmode=disable
TALLY_ENGINE_DB_URL=

# PostgreSQL connection string of the Reporting API's database, which the
# engine reads resources and events from. No default. Supports
# TALLY_ENGINE_REPORTING_DB_URL_FILE.
#
# Migration 0008 of the reporting chain creates the group role
# tally_engine_reader and grants it SELECT on events, current_resources,
# projects, and project_relations. A deployment creates the role this URL
# connects as and grants it membership in that group:
# CREATE ROLE <user> LOGIN PASSWORD '...';
# GRANT tally_engine_reader TO <user>;
#
# On the dev cluster the initdb script creates tally_engine as that member:
# TALLY_ENGINE_REPORTING_DB_URL=postgres://tally_engine:tally-dev-password@db.tally.127-0-0-1.nip.io:5432/tally_reporting?sslmode=disable
TALLY_ENGINE_REPORTING_DB_URL=

# Base URL of the VictoriaMetrics instance the metricsql counter sources are
# queried against. Needed only when the counter sources file declares
# metricsql sources; no default, because the endpoint differs per deployment.
#
# In the dev cluster the engine reaches VictoriaMetrics directly:
# TALLY_ENGINE_VM_URL=http://victoriametrics:8428
# The Gateway's https://vm.tally.127-0-0-1.nip.io:8443 works from outside the
# cluster only with the dev CA trusted by the process.
TALLY_ENGINE_VM_URL=

# Hours a run waits after its billing period has ended before it executes, so
# events that arrive late still reach the run that bills them.
TALLY_ENGINE_GRACE_HOURS=72

# Whether a completed run finalizes itself. False by default: a finalized run
# is immutable and its numbers may reach an ERP, so the step gets a human gate.
TALLY_ENGINE_AUTO_FINALIZE=false

# Relation types attribution walks, comma-separated. A project reached over one
# of them is billed under its attributor. The explicitly empty value disables
# attribution and bills every project on its own. member_of and managed_by
# reach a virtual project and attribute no cost, so a list naming either is
# refused at startup.
TALLY_ENGINE_ATTRIBUTING_RELATION_TYPES=infrastructure_tenant

# Relation types adjustment resolution walks from a statement's project to
# collect the pricing adjustments that apply to it, comma-separated. Defaults
# to managed_by,member_of. The explicitly empty value turns adjustments off. A
# type named here and in TALLY_ENGINE_ATTRIBUTING_RELATION_TYPES is walked by
# attribution and by adjustment resolution.
TALLY_ENGINE_ADJUSTMENT_RELATION_TYPES=managed_by,member_of

# How many relation levels that walk follows from the statement's project; 1 is
# the project's own relations. At least 1, and 3 by default; the empty type
# list above is what turns adjustments off.
TALLY_ENGINE_ADJUSTMENT_DEPTH=3

# Path to the counter sources YAML, the file that declares which counters exist
# and how each one is measured; counter-sources.example.yaml beside this file
# shows the format. The explicitly empty value means no counter sources. A path
# to a file that does not exist is an error when the file is read, not a run
# without counters.
TALLY_ENGINE_COUNTER_SOURCES=/etc/tally/counter-sources.yaml
