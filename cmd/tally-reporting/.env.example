# Reporting API configuration.
#
# Every variable is read from the environment with the TALLY_ prefix
# (roadmap/00-conventions.md section 8). Secrets also accept the *_FILE
# convention, which is how the dev overlay mounts them from a Kubernetes Secret:
# TALLY_REPORTING_DB_URL_FILE=/run/secrets/tally/db-url
# Setting a secret and its *_FILE companion at the same time is an error.

# Log level: DEBUG, INFO, WARN, ERROR.
TALLY_LOG_LEVEL=INFO

# Port the HTTP server listens on.
TALLY_REPORTING_HTTP_PORT=8080

# PostgreSQL connection string. Required; there is no default.
# Supports TALLY_REPORTING_DB_URL_FILE.
TALLY_REPORTING_DB_URL=

# Connections this replica may open. Size it against the database's
# max_connections divided by the number of replicas: left unset the pool would
# otherwise be sized after the node's CPU count, which says nothing about what
# the database can serve.
TALLY_REPORTING_DB_MAX_CONNS=10

# Authentication mode: enforced or disabled. Disabled serves every request
# without a credential and is for development and tests only.
TALLY_REPORTING_AUTH_MODE=enforced

# Shared secret guarding the /internal/* routes. Required unless
# TALLY_REPORTING_AUTH_MODE is disabled. Supports
# TALLY_REPORTING_INTERNAL_TOKEN_FILE.
TALLY_REPORTING_INTERNAL_TOKEN=

# How many seconds the database may stay unreachable before liveness answers
# 503 and Kubernetes restarts the pod. Readiness fails immediately either way.
TALLY_REPORTING_UNHEALTHY_THRESHOLD_S=600

# JWKS endpoint of an OIDC provider. Reserved: OIDC authentication is not
# implemented, and a set value refuses startup instead of being ignored.
TALLY_REPORTING_OIDC_JWKS_URL=

# Ingest strict mode. With the default false, an event whose payload carries a
# size for a (platform, resource_type) pair without a registered schema is
# accepted unvalidated. Set it to true and such an event is rejected and
# dead-lettered instead. The variable has no REPORTING infix by design.
TALLY_INGEST_REQUIRE_SIZE_SCHEMA=false

# Relation types that attribute cost, comma-separated. Creating a relation is
# refused when it would close a cycle over these types. An explicitly empty
# value disables that guard. member_of and managed_by reach a virtual project
# and attribute no cost, so a list naming either is refused at startup.
TALLY_REPORTING_ATTRIBUTING_RELATION_TYPES=infrastructure_tenant

# Path to the clouds YAML the reconciliation framework reads at startup: a
# clouds: list of cloud, platform, adapter, and adapter_config entries. Unset
# means no clouds are configured and every POST /internal/sync/{cloud} answers
# 404. The registry carries the OpenStack adapter: a cloud whose platform is
# openstack takes adapter: openstack. The file is validated against the
# registered adapters at startup. docs/openstack-reconciliation.md has the
# entry format and the adapter_config reference.
TALLY_REPORTING_CLOUDS_CONFIG=

# Path to the clouds.yaml the OpenStack adapter authenticates from. It is not a
# Tally variable: gophercloud reads it, the way every other OpenStack client on
# a host does. Set it, because it makes the named file the only location
# searched. Left unset, the search starts at the process working directory and
# reaches the mounted /etc/openstack/clouds.yaml last, so anything that can
# write a clouds.yaml into the working directory outranks the Secret and decides
# which cloud a sync books corrections from.
OS_CLIENT_CONFIG_FILE=/etc/openstack/clouds.yaml

# Metrics switch. With the default true, GET /metrics serves the Prometheus
# exposition and the gauge refresher runs. Set it to false and /metrics answers
# 404 and the refresher stops; the instruments stay in place and keep counting,
# so switching it back on costs nothing. The variable has no REPORTING infix by
# design.
TALLY_METRICS_ENABLED=true

# Seconds between two refreshes of the tally_current_resources gauge, which is
# re-derived from the projection on every tick. Must be positive.
TALLY_REPORTING_METRICS_REFRESH_S=60
